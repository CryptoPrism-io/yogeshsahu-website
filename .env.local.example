# Plausible Analytics (self-hosted, cookieless)
# NEXT_PUBLIC_PLAUSIBLE_SITE = the domain the site runs on (e.g. yogeshsahu.xyz)
# NEXT_PUBLIC_PLAUSIBLE_HOST  = where your self-hosted Plausible instance lives
#                              (e.g. https://plausible.yogeshsahu.xyz)
# In CI (deploy.yml) these are injected from the GitHub repo secrets of the same name.
NEXT_PUBLIC_PLAUSIBLE_SITE=yogeshsahu.xyz
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.yogeshsahu.xyz
